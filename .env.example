# Never commit your real .env file or paste secrets into the frontend.
MONGODB_URI=mongodb+srv://billnest_app:URL_ENCODED_PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=billnest
JWT_SECRET=replace-with-a-random-64-character-secret
AUDIT_LOG_SALT=replace-with-a-different-random-64-character-secret
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Password recovery is enabled only after you configure an email provider.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_replace_with_your_resend_api_key
# EMAIL_FROM=BillNest <support@your-verified-domain.example>

# Leave empty for one Vercel project where the frontend and /api share a domain.
VITE_API_URL=
