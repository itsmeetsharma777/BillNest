# MongoDB Atlas + server security (never commit real values)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=billnest
JWT_SECRET=replace-with-a-random-64-character-secret
AUDIT_LOG_SALT=replace-with-a-second-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
STORAGE_BUCKET=billnest-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OCR_PROVIDER=mock
OCR_API_KEY=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
